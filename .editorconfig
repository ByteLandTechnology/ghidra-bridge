root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.java]
indent_size = 2

[*.{gradle,kts}]
indent_size = 2

[*.{json,jsonl,yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = true

[*.sh]
indent_size = 2

[*.bat]
end_of_line = crlf
