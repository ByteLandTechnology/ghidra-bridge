root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.java]
indent_size = 2
max_line_length = 100

[*.{py,gradle}]
indent_size = 4

[*.{json,jsonl,yml,yaml,sh}]
indent_size = 2

[*.md]
trim_trailing_whitespace = true

[*.bat]
end_of_line = crlf
