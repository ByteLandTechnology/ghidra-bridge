import ghidra.app.script.GhidraScript;
import java.io.File;
import java.io.IOException;
import java.io.InputStream;
import java.lang.reflect.InvocationTargetException;
import java.lang.reflect.Method;
import java.net.URL;
import java.net.URLClassLoader;
import java.nio.file.Files;
import java.nio.file.Path;
import java.nio.file.StandardCopyOption;
import java.nio.file.attribute.BasicFileAttributes;
import java.util.Enumeration;
import java.util.Objects;
import java.util.jar.JarEntry;
import java.util.jar.JarFile;
import java.util.zip.CRC32;
import java.util.zip.ZipException;

public class __CLASS__ extends GhidraScript {
  private static final String JAR_NAME = "ghidra-bridge.jar";
  private static final String BOOTSTRAP_CLASS_ENTRY = "app/byteland/ghidra/Bootstrap.class";
  private static final int SNAPSHOT_ATTEMPTS = 8;
  private static final long SNAPSHOT_RETRY_DELAY_MILLIS = 100;

  @Override
  public void run() throws Exception {
    Path snapshot = null;
    try {
      File sourceJar = resolveJarFile();
      snapshot = snapshotJar(sourceJar);
      try (URLClassLoader loader =
          new BridgeClassLoader(snapshot.toUri().toURL(), GhidraScript.class.getClassLoader())) {
        Class<?> bootstrapClass = Class.forName("app.byteland.ghidra.Bootstrap", true, loader);
        Method startFromScript =
            bootstrapClass.getMethod(
                "__BOOTSTRAP_METHOD__", GhidraScript.class, String[].class, Runnable.class);
        println(
            "[__LOG_PREFIX__] Loading validated runtime jar snapshot: "
                + snapshot
                + " (source: "
                + sourceJar.getAbsolutePath()
                + ")");
        startFromScript.invoke(null, this, getScriptArgs(), (Runnable) () -> {});
      }
    } catch (Exception | LinkageError e) {
      printerr("[__LOG_PREFIX__] Startup failed: " + rootMessage(e));
      printerr("[__LOG_PREFIX__] See README.md for strict key=value startup arguments.");
      printerr("[__LOG_PREFIX__] Optional jar override: jar=/path/to/" + JAR_NAME);
      throw e;
    } finally {
      deleteSnapshot(snapshot, true);
    }
  }

  private Path snapshotJar(File sourceJar) throws IOException {
    Path source = sourceJar.toPath().toAbsolutePath().normalize();
    IOException lastFailure = null;

    for (int attempt = 1; attempt <= SNAPSHOT_ATTEMPTS; attempt++) {
      Path candidate = null;
      try {
        BasicFileAttributes before = Files.readAttributes(source, BasicFileAttributes.class);
        candidate = Files.createTempFile("ghidra-bridge-runtime-", ".jar");
        Files.copy(source, candidate, StandardCopyOption.REPLACE_EXISTING);
        BasicFileAttributes after = Files.readAttributes(source, BasicFileAttributes.class);

        if (!sameSourceState(before, after) || Files.size(candidate) != after.size()) {
          throw new IOException("Runtime jar changed while it was being copied");
        }

        validateJar(candidate);
        return candidate;
      } catch (IOException failure) {
        lastFailure = failure;
        deleteSnapshot(candidate, false);
        if (attempt < SNAPSHOT_ATTEMPTS) {
          waitBeforeSnapshotRetry(attempt);
        }
      }
    }

    throw new IOException(
        "Unable to create a stable, valid runtime jar snapshot after "
            + SNAPSHOT_ATTEMPTS
            + " attempts: "
            + source,
        lastFailure);
  }

  private boolean sameSourceState(BasicFileAttributes before, BasicFileAttributes after) {
    return Objects.equals(before.fileKey(), after.fileKey())
        && before.size() == after.size()
        && before.lastModifiedTime().equals(after.lastModifiedTime());
  }

  private void validateJar(Path snapshot) throws IOException {
    try (JarFile jar = new JarFile(snapshot.toFile(), true)) {
      if (jar.getJarEntry(BOOTSTRAP_CLASS_ENTRY) == null) {
        throw new ZipException("Runtime jar does not contain " + BOOTSTRAP_CLASS_ENTRY);
      }

      byte[] buffer = new byte[8192];
      Enumeration<JarEntry> entries = jar.entries();
      while (entries.hasMoreElements()) {
        JarEntry entry = entries.nextElement();
        if (entry.isDirectory()) {
          continue;
        }

        CRC32 crc = new CRC32();
        long size = 0;
        try (InputStream input = jar.getInputStream(entry)) {
          int read;
          while ((read = input.read(buffer)) != -1) {
            crc.update(buffer, 0, read);
            size += read;
          }
        }

        if (entry.getSize() >= 0 && entry.getSize() != size) {
          throw new ZipException("Invalid size for runtime jar entry: " + entry.getName());
        }
        if (entry.getCrc() >= 0 && entry.getCrc() != crc.getValue()) {
          throw new ZipException("Invalid CRC for runtime jar entry: " + entry.getName());
        }
      }
    }
  }

  private void waitBeforeSnapshotRetry(int attempt) throws IOException {
    try {
      Thread.sleep(SNAPSHOT_RETRY_DELAY_MILLIS * attempt);
    } catch (InterruptedException interrupted) {
      Thread.currentThread().interrupt();
      throw new IOException(
          "Interrupted while waiting to retry the runtime jar snapshot", interrupted);
    }
  }

  private void deleteSnapshot(Path snapshot, boolean reportFailure) {
    if (snapshot == null) {
      return;
    }
    try {
      Files.deleteIfExists(snapshot);
    } catch (IOException | SecurityException deletionFailure) {
      try {
        snapshot.toFile().deleteOnExit();
      } catch (SecurityException ignored) {
        // Ignore: deleteOnExit is best effort. The message below reports the failure.
      }
      if (reportFailure) {
        printerr(
            "[__LOG_PREFIX__] Could not delete runtime jar snapshot; scheduled for JVM exit: "
                + snapshot);
      }
    }
  }

  private File resolveJarFile() {
    File explicit = jarFromArgs();
    if (explicit != null) {
      return requireJar(explicit);
    }

    File scriptDir = scriptDirectory();
    if (scriptDir != null) {
      File besideScript = new File(scriptDir, JAR_NAME);
      if (besideScript.isFile()) {
        return besideScript;
      }
    }
    throw new IllegalStateException(
        "Unable to locate "
            + JAR_NAME
            + ". Keep it beside this script or pass jar=/absolute/path/to/"
            + JAR_NAME);
  }

  private File scriptDirectory() {
    var sourceFile = getSourceFile();
    if (sourceFile == null) {
      return null;
    }
    File localFile = sourceFile.getFile(false);
    return localFile == null ? null : localFile.getParentFile();
  }

  private File jarFromArgs() {
    String[] args = getScriptArgs();
    if (args == null) return null;
    for (String arg : args) {
      if (arg != null && arg.startsWith("jar=")) {
        String path = arg.substring(4);
        if (path.isBlank()) {
          throw new IllegalArgumentException("jar must be a non-empty absolute path");
        }
        File candidate = new File(path);
        if (!candidate.isAbsolute()) {
          throw new IllegalArgumentException("jar must be an absolute path: " + path);
        }
        return candidate;
      }
    }
    return null;
  }

  private File requireJar(File jar) {
    if (!jar.isFile()) {
      throw new IllegalStateException("Jar not found: " + jar.getAbsolutePath());
    }
    return jar;
  }

  private String rootMessage(Throwable error) {
    if (error instanceof InvocationTargetException invocation
        && invocation.getTargetException() != null) {
      Throwable target = invocation.getTargetException();
      String targetMessage = target.getMessage();
      if (targetMessage != null && !targetMessage.isBlank()) {
        return targetMessage;
      }
      error = target;
    }
    Throwable current = error;
    while (current.getCause() != null) {
      current = current.getCause();
    }
    String message = current.getMessage();
    return message == null || message.isBlank() ? current.getClass().getName() : message;
  }

  /** Loads bridge classes from the checked snapshot jar. Uses the parent class loader for host classes. */
  private static final class BridgeClassLoader extends URLClassLoader {
    private static final String BRIDGE_PACKAGE_PREFIX = "app.byteland.ghidra.";

    BridgeClassLoader(URL snapshotUrl, ClassLoader parent) {
      super(new URL[] {snapshotUrl}, parent);
    }

    @Override
    protected Class<?> loadClass(String name, boolean resolve) throws ClassNotFoundException {
      synchronized (getClassLoadingLock(name)) {
        Class<?> loaded = findLoadedClass(name);
        if (loaded == null) {
          loaded =
              name.startsWith(BRIDGE_PACKAGE_PREFIX)
                  ? findClass(name)
                  : super.loadClass(name, false);
        }
        if (resolve) {
          resolveClass(loaded);
        }
        return loaded;
      }
    }
  }
}
